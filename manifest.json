{
    "manifest_version": 3,
    "name": "Yapster",
    "version": "1.0",
    "description": "Adds a plugin system to Yapper.",
    "icons": {
        "16": "assets/icon-16.png",
        "32": "assets/icon-32.png",
        "48": "assets/icon-48.png",
        "128": "assets/icon-128.png"
    },
    "minimum_chrome_version": "111",
    "permissions": ["storage", "scripting"],
    "host_permissions": ["https://www.yapper.website/*", "https://pastebin.com/*"],
    "background": {
        "service_worker": "background.js",
        "scripts": ["background.js"]
    },
    "content_scripts": [
        {
            "matches": ["https://www.yapper.website/*"],
            "js": ["core/core.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://www.yapper.website/*"],
            "js": ["plugins/bridge.js"],
            "run_at": "document_start"
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "koulmoir@gmail.com",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
