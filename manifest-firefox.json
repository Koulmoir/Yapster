{
    "manifest_version": 3,
    "name": "Yapper Plugins",
    "version": "1.0",
    "description": "Adds a plugin system to Yapper.",
    "permissions": ["storage", "scripting"],
    "host_permissions": ["https://www.yapper.website/*"],
    "background": {
        "scripts": ["background.js"]
    },
    "content_scripts": [
        {
            "matches": ["https://www.yapper.website/*"],
            "js": ["core/core.js"],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "koulmoir@gmail.com"
        }
    }
}
